// Monara A4 submission PDFs. Approved design and build notes: docs/tech/pdf/README.md.
// Body content is supplied unchanged by Pandoc. All text stays selectable.
#let brand = rgb("#3171FD")
#let accent = rgb("#2459d6")
#let ink = rgb("#18274b")
#let muted = rgb("#61708a")
#let hairline = rgb("#d5dff0")
#let soft = rgb("#eaf0ff")
#let canvas = white
#let navy = rgb("#193b91")
#let lockup-blue = "/apps/web/public/logos/monara-lockup-light.svg"
#let lockup-white = "/apps/web/public/logos/monara-lockup-dark.svg"
#let doc-index = if "$kind$" == "Technical Documentation" { 1 } else if "$kind$" == "Security Self-Assessment" { 2 } else { 3 }
#let doc-code = "0" + str(doc-index)
#let cover-title = if doc-index == 1 { [Technical\ Documentation] } else if doc-index == 2 { [Security\ Self-Assessment] } else { [Execution\ Evidence] }
#let motifs = if doc-index == 1 { ("Architecture", "Algorithms", "Security") } else if doc-index == 2 { ("Identity", "Permissions", "Known risks") } else { ("Tasks", "Attacks", "Extraction") }

#set document(title: "$title$ $kind$", author: "Monara, Team 808")
#set text(font: ("Nunito Sans", "Helvetica Neue", "Arial"), size: 10pt, fill: ink, lang: "en")
#set smartquote(enabled: false)
#set terms(hanging-indent: 1.5em)

// A full-bleed vector cover with its own coordinated header and footer.
#page(paper: "a4", margin: 0pt, header: none, footer: none)[
  #place(top + left, image("/docs/tech/pdf/cover-background.svg", width: 100%, height: 100%))
  #place(top + left, dx: 1.4cm, dy: 1.3cm, image(lockup-white, width: 5.5cm))
  #place(top + right, dx: -1.4cm, dy: 0.9cm, text(font: "Montserrat", size: 62pt, weight: 800, fill: white.transparentize(85%))[#doc-code])
  #place(top + left, dx: 1.4cm, dy: 5.0cm, block(width: 18.2cm)[
    #set text(fill: white)
    #text(font: "Montserrat", size: 8pt, weight: "bold", tracking: 0.08em)[SUBMISSION PACKAGE / #doc-code OF 03]
    #v(0.6cm)
    #text(font: "Montserrat", size: if doc-index == 2 { 43pt } else { 47pt }, weight: 800, tracking: -0.045em)[#cover-title]
$if(subtitle)$
    #v(0.55cm)
    #block(width: 15.9cm)[#text(size: 15pt, fill: rgb("#dbe7ff"))[$subtitle$]]
$endif$
    #v(0.85cm)
    #for (i, item) in motifs.enumerate() {
      if i > 0 { h(0.25cm); text(fill: rgb("#bcd3ff"))[→]; h(0.25cm) }
      box(inset: (x: 10pt, y: 8pt), radius: 8pt, stroke: 0.5pt + white.transparentize(65%), fill: white.transparentize(96%))[
        #text(font: "Montserrat", weight: "bold", size: 8pt)[#item]
      ]
    }
  ])
  #place(top + left, dx: 1.4cm, dy: 22.2cm, block(width: 18.2cm)[
    #set text(fill: white, size: 9pt)
    #line(length: 100%, stroke: 0.5pt + white.transparentize(65%))
    #v(0.2cm)
    #grid(columns: (1fr, 1fr), column-gutter: 0.7cm,
      [#text(size: 6.5pt, weight: "bold", tracking: 0.09em, fill: rgb("#bad0ff"))[COMPETITION]
      #v(0.1cm)
      2026 Shenzhen International FinTech Competition (FinTechathon)],
      [#text(size: 6.5pt, weight: "bold", tracking: 0.09em, fill: rgb("#bad0ff"))[TRACK AND TOPIC]
      #v(0.1cm)
      International Track, Topic A: Personal Finance Assistant],
    )
    #v(0.3cm)
    #grid(columns: (1fr, 1fr), column-gutter: 0.7cm,
      [#text(size: 6.5pt, weight: "bold", tracking: 0.09em, fill: rgb("#bad0ff"))[TEAM]
      #v(0.1cm)
      Team 808],
$if(owner)$
      [#text(size: 6.5pt, weight: "bold", tracking: 0.09em, fill: rgb("#bad0ff"))[OWNER / FEATURES]
      #v(0.1cm)
      $owner$ / $features$],
$else$
      [],
$endif$
    )
    #v(0.45cm)
    #box(inset: (x: 9pt, y: 5pt), radius: 20pt, stroke: 0.5pt + white.transparentize(60%))[
      #text(font: "Montserrat", size: 7pt, weight: "bold")[$version$, $date$]
    ]
  ])
  #place(bottom + left, dx: 1.4cm, dy: -0.65cm, text(size: 6.5pt, tracking: 0.09em, fill: rgb("#c4d8ff"))[#upper[$title$, an AI personal finance Agent]])
  #place(bottom + right, dx: -1.4cm, dy: -0.65cm, text(size: 6.5pt, fill: rgb("#c4d8ff"))[#doc-code / 03])
]

#set page(
  background: image("/docs/tech/pdf/page-frame.svg", width: 100%, height: 100%),
  paper: "a4",
  fill: canvas,
  margin: (top: 3cm, bottom: 2.3cm, x: 1.8cm),
  header: [
    #grid(columns: (1fr, auto), align: (left + horizon, right + horizon),
      image(lockup-blue, height: 0.52cm),
      box(fill: soft, radius: 20pt, inset: (x: 10pt, y: 6pt))[
        #text(font: "Montserrat", size: 6.8pt, weight: "bold", fill: accent)[#doc-code / #upper[$kind$]]
      ],
    )
    #v(0.12cm)
    #grid(columns: (1fr, auto),
      text(size: 6.4pt, fill: muted, tracking: 0.06em)[FINTECHATHON 2026 / INTERNATIONAL TRACK],
      text(size: 6.4pt, fill: muted, tracking: 0.06em)[TEAM 808],
    )
    #v(-0.05cm)
    #line(length: 100%, stroke: 0.6pt + hairline)
  ],
  header-ascent: 20%,
  footer: context [
    #let current = counter(page).get().first()
    #let total = counter(page).final().first()
    #grid(columns: (current * 1fr, calc.max(0.001, total - current) * 1fr), column-gutter: 0pt,
      rect(width: 100%, height: 2pt, fill: brand, radius: 1pt),
      rect(width: 100%, height: 2pt, fill: hairline, radius: 1pt),
    )
    #v(0.16cm)
    #grid(columns: (1fr, auto), align: (left + horizon, right + horizon),
      text(font: "Montserrat", size: 6.5pt, weight: "bold", fill: navy)[MONARA / TEAM 808],
      text(size: 7pt, fill: muted)[$version$ #h(0.4em) · #h(0.4em) #current / #total],
    )
  ],
  footer-descent: 38%,
)

#set par(leading: 0.68em, spacing: 0.95em)
#set list(indent: 0.6em, body-indent: 0.5em, marker: ([•], [–]))
#set enum(indent: 0.6em, body-indent: 0.5em)

#set heading(numbering: (..n) => if n.pos().len() <= 2 { numbering("1.1", ..n) })
#show heading.where(level: 1): it => {
$if(flow)$
  v(1.4em, weak: true)
$else$
  pagebreak(weak: true)
$endif$
  block(width: 100%, below: 1.3em, breakable: false, sticky: true)[
    #box(fill: brand, radius: (top-right: 7pt, bottom-right: 7pt), inset: (x: 11pt, y: 6pt))[
      #text(font: "Montserrat", size: 8pt, weight: "bold", fill: white, tracking: 0.05em)[
        #if it.numbering != none { counter(heading).display(it.numbering); h(0.6em) }
        #upper[$kind$]
      ]
    ]
    #v(0.22cm)
    #text(font: "Montserrat", size: 25pt, weight: 800, fill: ink)[#it.body]
  ]
}
#show heading.where(level: 2): it => block(above: 1.6em, below: 0.8em, width: 100%, breakable: false, sticky: true)[
  #text(font: "Montserrat", size: 14pt, weight: "bold", fill: ink)[
    #if it.numbering != none { text(fill: brand)[#counter(heading).display(it.numbering)]; h(0.5em) }
    #it.body
  ]
  #v(-0.1cm)
  #line(length: 100%, stroke: 0.7pt + hairline)
]
#show heading.where(level: 3): it => block(above: 1.3em, below: 0.6em, breakable: false, sticky: true)[
  #text(size: 11.5pt, weight: "bold", fill: accent)[#it.body]
]
#show heading.where(level: 4): it => block(above: 1.1em, below: 0.5em, breakable: false, sticky: true)[
  #text(size: 10pt, weight: "bold", fill: ink)[#it.body]
]
#show heading.where(level: 5): it => block(above: 1em, below: 0.4em, breakable: false, sticky: true)[
  #text(size: 10pt, weight: "bold", style: "italic", fill: muted)[#it.body]
]

#show link: it => text(fill: accent)[#underline(offset: 1.5pt, stroke: 0.5pt + hairline)[#it]]
#show strong: set text(weight: "bold")

#show raw.where(block: false): it => highlight(fill: soft, extent: 1pt, radius: 2pt, text(font: "Geist Mono", size: 1em, fill: ink, it))
#show raw.where(block: true): it => block(breakable: false, fill: white, stroke: 0.6pt + hairline, radius: 8pt, inset: 10pt, width: 100%, text(font: "Geist Mono", size: 1em, fill: ink, it))

#set table(
  inset: (x: 6pt, y: 5pt),
  stroke: (x, y) => (bottom: 0.5pt + hairline),
  fill: (x, y) => if y == 0 { soft } else if calc.odd(y) { white } else { rgb("#f0f3fb") },
)
#show table: it => block(breakable: true, stroke: 0.7pt + hairline, radius: 7pt, clip: true, inset: 0pt)[
  #set text(size: 8.5pt)
  #it
]
#show table.cell: set align(left)
#show table.cell.where(y: 0): set text(weight: "bold", fill: ink)
#show figure.where(kind: table): set figure.caption(position: top)
#show figure.where(kind: table): set block(breakable: true)
#show figure.where(kind: image): set figure.caption(position: bottom)
#show figure.caption: set text(size: 8.5pt, fill: muted)

#let horizontalRule = line(start: (25%, 0%), end: (75%, 0%), stroke: 0.6pt + hairline)
#let divider = if "divider" in std { divider } else { horizontalRule }

#show quote.where(block: true): it => block(
  inset: (x: 12pt, y: 9pt), fill: soft, radius: (top-right: 8pt, bottom-right: 8pt), stroke: (left: 2.5pt + brand), width: 100%,
)[#text(fill: muted)[#it.body]]

$if(toc)$
#block(below: 0.4cm)[
  #text(font: "Montserrat", size: 27pt, weight: 800, fill: ink)[Contents]
  #v(0.1cm)
  #line(length: 100%, stroke: 1.4pt + brand)
]
#show outline.entry.where(level: 1): it => {
  v(0.5em, weak: true)
  text(weight: "bold")[#it]
}
#outline(title: none, depth: 2, indent: 1.2em)

$endif$
$body$
