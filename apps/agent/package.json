{
  "name": "@monara/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "sandbox": "node sandbox/run.ts",
    "sandbox:email-attacks": "node sandbox/run-email-attacks.ts"
  },
  "dependencies": {
    "@monara/contracts": "workspace:*",
    "@monara/integrations": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261009.1",
    "@types/node": "20.19.43",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  }
}
