{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monara-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "preview_urls": false,
  // Persist only the runtime's structured stage/error logs, without request logs.
  "observability": {
    "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false }
  },
  // One object per User holds their WhatsApp conversation. See src/whatsapp/conversation.ts.
  "durable_objects": {
    "bindings": [{ "name": "CONVERSATIONS", "class_name": "WhatsAppConversation" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WhatsAppConversation"] }],
  // Declared only. The queue is created in Cloudflare by an authorized deploy, never by local commands.
  "queues": {
    "producers": [
      { "binding": "GMAIL_JOBS", "queue": "monara-gmail-jobs" },
      { "binding": "MERCHANT_JOBS", "queue": "monara-merchant-jobs" }
    ],
    "consumers": [
      {
        "queue": "monara-gmail-jobs",
        // Parse jobs carry at most 3 emails to leave room for activity checks before
        // each provider call. Busy models yield to the queue instead of retrying inline.
        // Older, larger jobs are split by the consumer before doing provider work.
        "max_batch_size": 1,
        // Every hop used to wait up to 5 s for a batch to fill; onboarding makes two hops.
        "max_batch_timeout": 1,
        // Invocations at once. 3 jobs × GMAIL_PARSE_CONCURRENCY (default 2) = 6 model calls in
        // parallel; raise both only as far as the model's tokens-per-minute limit allows.
        "max_concurrency": 3,
        // Keep in sync with GMAIL_QUEUE_MAX_RETRIES in src/gmail/worker.ts.
        "max_retries": 3
      },
      {
        // One job per invocation keeps three cold business lookups below the
        // subrequest budget. Five invocations preserve the previous upper bound
        // of five parallel jobs without sharing one invocation's request limit.
        "queue": "monara-merchant-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 5,
        "max_retries": 5
      }
    ]
  },
  "triggers": {
    // Every 15 minutes: deliver budget alerts held by quiet hours. Daily 17:00 UTC (00:00
    // Jakarta): refresh spending forecasts.
    // Daily at 01:00 UTC (08:00 WIB): new-bank discovery and a catch-up import per mailbox.
    "crons": ["* * * * *", "*/15 * * * *", "0 1 * * *", "0 17 * * *"]
  }
}
