# Copy to .env.local. Empty values are intentional.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side only:
# Used only after a route verifies a User or trusted service identity. Every
# service-role query must still be scoped to that verified User.
SUPABASE_SERVICE_ROLE_KEY=
MONARA_AGENT_URL=http://localhost:8787
MONARA_AGENT_BACKEND_SECRET=
COMPOSIO_API_URL=https://backend.composio.dev/api/v3.1
COMPOSIO_API_KEY=
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
COMPOSIO_WEBHOOK_SECRET=
# "true" lets Monara create Composio new-mail triggers for linked bank senders.
COMPOSIO_GMAIL_TRIGGERS_ENABLED=
KAPSO_WEBHOOK_SECRET=
# Keys the WhatsApp Link phone hashes and codes. Changing it unlinks everyone.
WHATSAPP_LINK_SECRET=
# Monara's WhatsApp number in E.164, shown with the link code.
MONARA_WHATSAPP_NUMBER=
# Local Gmail testing only: use a public hostname or https://hostname here.
# Run `pnpm dev` and `pnpm dev:tunnel`, then sign in on the public origin.
# The Composio project identity verifier uses /api/gmail/connections/callback;
# Supabase Auth must allow /auth/callback on that same public origin.
# The authtoken is optional when ngrok's own config already has one. Secret.
NGROK_DOMAIN=
NGROK_AUTHTOKEN=
