# Copy to .env.local. Empty values are intentional.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side only:
# Used only after a route verifies a User or trusted service identity. Every
# service-role query must still be scoped to that verified User.
SUPABASE_SERVICE_ROLE_KEY=
MONARA_AGENT_URL=http://localhost:8787
MONARA_AGENT_BACKEND_SECRET=
COMPOSIO_API_URL=https://backend.composio.dev/api/v3.1
COMPOSIO_API_KEY=
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
COMPOSIO_WEBHOOK_SECRET=
KAPSO_WEBHOOK_SECRET=
# Local Gmail testing only: `pnpm dev:tunnel` exposes the web app on this
# ngrok domain, which the Composio callback URL points at. The authtoken is
# optional when ngrok's own config already has one. Secret.
NGROK_DOMAIN=
NGROK_AUTHTOKEN=
