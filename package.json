{
  "name": "monara",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @monara/web dev",
    "build": "pnpm -r --if-present build",
    "start": "pnpm --filter @monara/web start",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev:web": "pnpm --filter @monara/web dev",
    "dev:agent": "pnpm --filter @monara/agent dev",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:types": "node scripts/generate-db-types.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.63.0",
    "supabase": "2.120.0"
  }
}
